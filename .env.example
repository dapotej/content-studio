# Neon Postgres connection string (pooled).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# The old shared password.
# Only used once, to claim the first workspace when no accounts exist yet.
APP_PASSWORD=
# Long random string used to sign the session cookie: `openssl rand -hex 32`
AUTH_SECRET=
# Vercel Blob store for uploaded and generated photos/clips (set automatically when the store is connected in Vercel).
BLOB_READ_WRITE_TOKEN=
# fal.ai key for AI images and video (fal.ai dashboard → Keys).
FAL_KEY=
# Auto-posting to Instagram and LinkedIn (zernio.com → Settings → API keys)
ZERNIO_API_KEY=
# Optional: override the fal.ai models.
# FAL_IMAGE_MODEL=blackforestlabs/flux-3/text-to-image
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# Sign-up is invite-only unless this is "true".
# SIGNUPS_OPEN=false
# Payments (each is off until set). Stripe: USD cards.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_AGENCY=
# Paystack: NGN.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PLAN_STARTER=
# PAYSTACK_PLAN_GROWTH=
# PAYSTACK_PLAN_AGENCY=

# Reliability: Vercel sends this to the daily safety check (/api/public/cron). `openssl rand -hex 32`
# CRON_SECRET=
# The app's public address, used in webhook and email links (default https://app.buzzbite.io).
# APP_URL=
# Email (notification digests, failed posts, password reset links). Off until set.
# Zoho CPaaS / ZeptoMail: the agent's send mail token (without "Zoho-enczapikey"), and the API host
# shown with it if it isn't api.zeptomail.com (e.g. api.zeptomail.eu).
# ZOHO_SEND_TOKEN=
# ZOHO_MAIL_HOST=api.zeptomail.com
# Or Resend instead:
# RESEND_API_KEY=
# EMAIL_FROM=Buzzbite <hello@buzzbite.io>
# Cost tracking: estimated US dollars per fal.ai job, as JSON, to override the defaults in src/lib/usage.ts.
# FAL_COSTS={"fal-ai/kling-video/v2.1/standard/image-to-video":0.25}
